MINIO_CONSOLE_PORT=19001
ICEBERG_REST_PORT=8181

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
LAKEHOUSE_BUCKET=lakehouse
